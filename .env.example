# 4 цифры для входа
ALFRED_PIN=0000

# Адрес приложения (нужен для Face ID). Локально: http://localhost:8100
ORIGIN=https://alfred.bbifather.site
# Порт на сервере, на который nginx проксирует запросы
PORT=8100
TZ=Europe/Moscow

POSTGRES_PASSWORD=change-me

OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
# Прокси для запросов к OpenAI, например http://user:pass@host:port или socks5://...
OPENAI_PROXY=

# Ключи для пушей: сгенерировать командой ./alfred.sh vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUB=mailto:admin@bbifather.site
